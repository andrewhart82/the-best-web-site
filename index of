```html
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Medical Undergraduate Research</title>

    <style>

        /* Page Layout */
        body {
            margin: 0;
            padding: 20px;
            font-family: Arial, sans-serif;

            min-height: 100vh;

            display: flex;
            flex-direction: column;

            box-sizing: border-box;
        }

        /* Responsive Header */
        header {
            font-size: clamp(28px, 5vw, 45px);
            text-align: center;
            margin: 20px 0;
            font-weight: bold;
        }

        /* Intro Text */
        .intro-text {
            font-size: 16px;
            line-height: 1.6;
            text-align: center;

            max-width: 700px;

            margin: 0 auto 40px auto;
        }

        /* Navigation Button Container */
        .button-grid {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;

            gap: 15px;

            margin-bottom: 30px;
        }

        /* Navigation Links */
        .btn-link {
            text-decoration: none;
        }

        /* Navigation Buttons */
        .btn-link button {
            background-color: blue;
            color: white;

            cursor: pointer;

            border-radius: 100px;
            border: outset blue 3px;

            height: 45px;

            padding: 0 25px;

            font-family: inherit;
            font-weight: bold;

            transition: transform 0.2s, background-color 0.2s;
        }

        .btn-link button:hover {
            background-color: darkblue;
            transform: scale(1.05);
        }

        /* Submit Research Button Area */
        .submit-area {
            text-align: center;
            margin-bottom: 50px;
        }

        /* Submit Research Button */
        .popup-button {
            background-color: blue;
            color: white;

            cursor: pointer;

            border-radius: 100px;
            border: outset blue 3px;

            padding: 12px 28px;

            font-family: inherit;
            font-weight: bold;
            font-size: 15px;

            transition: transform 0.2s, background-color 0.2s;
        }

        .popup-button:hover {
            background-color: darkblue;
            transform: scale(1.05);
        }

        /* Dark Background Behind Popup */
        .popup-overlay {
            display: none;

            position: fixed;

            z-index: 1000;

            left: 0;
            top: 0;

            width: 100%;
            height: 100%;

            background-color: rgba(0, 0, 0, 0.6);
        }

        /* Popup Window */
        .popup-box {
            background-color: white;

            width: 90%;
            max-width: 500px;

            max-height: 90vh;
            overflow-y: auto;

            padding: 30px;

            border-radius: 15px;

            position: absolute;

            top: 50%;
            left: 50%;

            transform: translate(-50%, -50%);

            box-sizing: border-box;

            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        }

        /* Popup Heading */
        .popup-box h2 {
            text-align: center;
            margin-top: 0;
        }

        /* Popup Intro Text */
        .popup-description {
            text-align: center;
            line-height: 1.5;
            margin-bottom: 20px;
        }

        /* Close X */
        .close-popup {
            position: absolute;

            right: 18px;
            top: 10px;

            font-size: 28px;
            font-weight: bold;

            cursor: pointer;

            color: #444444;
        }

        .close-popup:hover {
            color: black;
        }

        /* Research Form */
        #researchForm {
            display: flex;
            flex-direction: column;

            gap: 10px;
        }

        /* Form Labels */
        #researchForm label {
            text-align: left;

            font-weight: bold;

            margin-top: 5px;
        }

        /* Form Inputs */
        #researchForm input,
        #researchForm textarea {
            width: 100%;

            box-sizing: border-box;

            padding: 10px;

            border: 1px solid #cccccc;
            border-radius: 8px;

            font-family: inherit;
            font-size: 15px;
        }

        /* Focus Effect */
        #researchForm input:focus,
        #researchForm textarea:focus {
            outline: 2px solid blue;
            border-color: blue;
        }

        /* Prevent Textarea From Stretching Too Far */
        #researchForm textarea {
            resize: vertical;
            min-height: 120px;
        }

        /* Status Message */
        #formStatus {
            margin-top: 15px;

            text-align: center;

            font-weight: bold;
        }

        /* Footer */
        footer {
            margin-top: auto;

            text-align: center;

            padding: 20px 0;

            font-size: 14px;

            color: #777777;

            border-top: 1px solid #eeeeee;
        }


        /* Mobile Adjustments */
        @media (max-width: 600px) {

            body {
                padding: 12px;
            }

            .btn-link {
                width: 100%;
            }

            .btn-link button {
                width: 100%;
            }

            .popup-box {
                width: 95%;
                padding: 25px 20px;
            }

        }

    </style>

</head>


<body>


    <!-- HEADER -->

    <header>
        MEDICAL RESEARCH
    </header>


    <!-- INTRODUCTION -->

    <p class="intro-text">

        Welcome to Medical Undergraduate Research! We are glad that you found us.

        Our aim is to provide the ability to publish without the headache.

        Our mission is to further the work of science.

        We have our criteria located here

        <a
            href="https://docs.google.com/document/d/1gdD_zB0JvRiO5_f_IaHT8qDHIwqkO3MM/edit"
            target="_blank"
        >
            criteria document
        </a>.

        This is a grass roots approach, but we will publish peer reviewed papers.

        I want you to email me your work and we will start the work of peer review
        and publishing.

    </p>


    <!-- SUBJECT NAVIGATION -->

    <nav class="button-grid">

        <a
            class="btn-link"
            href="psychology.html"
            target="_blank"
        >
            <button type="button">
                PSYCHOLOGY
            </button>
        </a>


        <a
            class="btn-link"
            href="chemistry.html"
            target="_blank"
        >
            <button type="button">
                CHEMISTRY
            </button>
        </a>


        <a
            class="btn-link"
            href="biology.html"
            target="_blank"
        >
            <button type="button">
                BIOLOGY
            </button>
        </a>


        <a
            class="btn-link"
            href="physics.html"
            target="_blank"
        >
            <button type="button">
                PHYSICS
            </button>
        </a>


        <a
            class="btn-link"
            href="alliedhealth.html"
            target="_blank"
        >
            <button type="button">
                ALLIED HEALTH
            </button>
        </a>


        <a
            class="btn-link"
            href="miscellaneous.html"
            target="_blank"
        >
            <button type="button">
                MISCELLANEOUS
            </button>
        </a>


        <a
            class="btn-link"
            href="other.html"
            target="_blank"
        >
            <button type="button">
                OTHER
            </button>
        </a>

    </nav>


    <!-- SUBMIT RESEARCH BUTTON -->

    <div class="submit-area">

        <button
            class="popup-button"
            type="button"
            onclick="openPopup()"
        >
            SUBMIT RESEARCH
        </button>

    </div>


    <!-- RESEARCH SUBMISSION POPUP -->

    <div
        id="researchPopup"
        class="popup-overlay"
    >

        <div class="popup-box">

            <!-- X CLOSE BUTTON -->

            <span
                class="close-popup"
                onclick="closePopup()"
            >
                &times;
            </span>


            <h2>
                Submit Your Research
            </h2>


            <p class="popup-description">

                Fill out the form below to begin the peer review
                and publishing process.

            </p>


            <!-- RESEARCH FORM -->

            <form id="researchForm">


                <!-- NAME -->

                <label for="name">
                    Your Name
                </label>

                <input
                    type="text"
                    id="name"
                    name="name"
                    placeholder="Your full name"
                    required
                >


                <!-- EMAIL -->

                <label for="email">
                    Email Address
                </label>

                <input
                    type="email"
                    id="email"
                    name="email"
                    placeholder="you@example.com"
                    required
                >


                <!-- RESEARCH TITLE -->

                <label for="researchTitle">
                    Research Title
                </label>

                <input
                    type="text"
                    id="researchTitle"
                    name="title"
                    placeholder="Title of your research paper"
                    required
                >


                <!-- SUBJECT -->

                <label for="subject">
                    Research Subject
                </label>

                <select
                    id="subject"
                    name="subject"
                    required
                >

                    <option value="">
                        Select a subject
                    </option>

                    <option value="Psychology">
                        Psychology
                    </option>

                    <option value="Chemistry">
                        Chemistry
                    </option>

                    <option value="Biology">
                        Biology
                    </option>

                    <option value="Physics">
                        Physics
                    </option>

                    <option value="Allied Health">
                        Allied Health
                    </option>

                    <option value="Miscellaneous">
                        Miscellaneous
                    </option>

                    <option value="Other">
                        Other
                    </option>

                </select>


                <!-- MESSAGE -->

                <label for="message">
                    Message
                </label>

                <textarea
                    id="message"
                    name="message"
                    placeholder="Tell us a little about your research..."
                    required
                ></textarea>


                <!-- SUBMIT BUTTON -->

                <button
                    type="submit"
                    class="popup-button"
                >
                    SUBMIT RESEARCH
                </button>

            </form>


            <!-- FORM STATUS -->

            <p id="formStatus"></p>


        </div>

    </div>


    <!-- FOOTER -->

    <footer>
        ezra is cool
    </footer>


    <!-- JAVASCRIPT -->

    <script>

        /* OPEN POPUP */

        function openPopup() {

            document
                .getElementById("researchPopup")
                .style.display = "block";

        }


        /* CLOSE POPUP */

        function closePopup() {

            document
                .getElementById("researchPopup")
                .style.display = "none";

        }


        /* CLOSE POPUP WHEN CLICKING DARK AREA */

        window.addEventListener("click", function(event) {

            const popup =
                document.getElementById("researchPopup");

            if (event.target === popup) {

                closePopup();

            }

        });


        /* CLOSE POPUP WITH ESCAPE KEY */

        document.addEventListener("keydown", function(event) {

            if (event.key === "Escape") {

                closePopup();

            }

        });


        /* FORM SUBMISSION */

        document
            .getElementById("researchForm")
            .addEventListener(
                "submit",
                async function(event) {

                    event.preventDefault();


                    const status =
                        document.getElementById("formStatus");


                    const formData = {

                        name:
                            document
                                .getElementById("name")
                                .value,

                        email:
                            document
                                .getElementById("email")
                                .value,

                        title:
                            document
                                .getElementById("researchTitle")
                                .value,

                        subject:
                            document
                                .getElementById("subject")
                                .value,

                        message:
                            document
                                .getElementById("message")
                                .value

                    };


                    status.textContent =
                        "Submitting your research...";


                    try {

                        /*
                            This will eventually connect
                            to your backend server.
                        */

                        const response =
                            await fetch(
                                "/api/submit-research",
                                {

                                    method: "POST",

                                    headers: {

                                        "Content-Type":
                                            "application/json"

                                    },

                                    body:
                                        JSON.stringify(formData)

                                }
                            );


                        if (!response.ok) {

                            throw new Error(
                                "Submission failed."
                            );

                        }


                        status.textContent =
                            "Your research was submitted successfully!";


                        document
                            .getElementById("researchForm")
                            .reset();


                    }

                    catch (error) {

                        console.error(error);


                        status.textContent =
                            "The submission form is ready, but the email server has not been connected yet.";

                    }

                }
            );

    </script>


</body>

</html>
